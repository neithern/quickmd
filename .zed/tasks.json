[
  {
    "label": "QuickMD: Build Debug (CLT)",
    "command": "./scripts/clt-build.sh",
    "args": ["build", "Debug"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "QuickMD: Build Release (CLT)",
    "command": "./scripts/clt-build.sh",
    "args": ["release"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "QuickMD: Run (CLT, build + open)",
    "command": "./scripts/clt-build.sh",
    "args": ["run", "Debug"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "QuickMD: Clean (CLT)",
    "command": "./scripts/clt-build.sh",
    "args": ["clean"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "QuickMD: Show App Path (CLT)",
    "command": "./scripts/clt-build.sh",
    "args": ["path", "Debug"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
